<Window x:Class="Opticon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opticon" Width="1200" Height="780" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen"
        Foreground="#E7E9EE" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Icon="Opticon.ico">
  <Window.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0C0E14" Offset="0"/><GradientStop Color="#110F1B" Offset="1"/></LinearGradientBrush>
  </Window.Background>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Menu -->
    <Border Grid.Column="0" Background="#0E1118" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="14,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
          <Image Source="Opticon.ico" Width="30" Height="30" Margin="0,0,10,0"/>
          <TextBlock Text="Opticon" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0" TextWrapping="Wrap"/>
        <StackPanel>
          <RadioButton x:Name="NavOverview" Style="{StaticResource Nav}" GroupName="nav" Content="🏠  Overblik" IsChecked="True" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavSecurity" Style="{StaticResource Nav}" GroupName="nav" Content="🛡  Sikkerhed" Tag="Sikkerhed" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" GroupName="nav" Content="🧹  Oprydning" Tag="Oprydning" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavGame" Style="{StaticResource Nav}" GroupName="nav" Content="🎮  Spil og grafik" Tag="Spil og grafik" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" GroupName="nav" Content="ℹ  Om Opticon" Checked="Nav_Checked"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Sider -->
    <Grid Grid.Column="1" Margin="32,26,32,24">
      <!-- Overblik -->
      <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Overblik" Style="{StaticResource H1}"/>
          <TextBlock Text="Din pc på et øjeblik." Style="{StaticResource Sub}" Margin="0,4,0,20"/>
          <UniformGrid Columns="2">
            <Border Style="{StaticResource CardB}" Margin="0,0,10,14">
              <StackPanel>
                <TextBlock Text="💻  System" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtWindows" Text="Henter…" FontSize="16"/>
                <TextBlock x:Name="TxtBuild" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                <TextBlock x:Name="TxtBoard" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardB}" Margin="10,0,0,14">
              <StackPanel>
                <TextBlock Text="⚙  Processor" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtCpu" Text="Henter…" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtCpuDetail" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardB}" Margin="0,0,10,14">
              <StackPanel>
                <TextBlock Text="🎮  Grafikkort" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtGpu" Text="Henter…" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardB}" Margin="10,0,0,14">
              <StackPanel>
                <TextBlock Text="🧠  Hukommelse og disk" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtRam" Text="Henter…" FontSize="16"/>
                <ProgressBar x:Name="BarRam" Height="6" Margin="0,8,0,12" Maximum="100" Background="#1E2433" BorderThickness="0" Foreground="#8B5CF6"/>
                <TextBlock x:Name="TxtDisk" FontSize="14"/>
                <ProgressBar x:Name="BarDisk" Height="6" Margin="0,8,0,0" Maximum="100" Background="#1E2433" BorderThickness="0" Foreground="#3B9EFF"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Style="{StaticResource CardB}" Margin="0,4,0,0" Background="#1B1630" BorderBrush="#3B3366">
            <StackPanel>
              <TextBlock Text="🚧  Opticon flytter ind i et rigtigt Windows-program" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" Text="Det her er første version af den nye app. Funktionerne fra den gamle Opticon (sikkerhedstjek, oprydning, spil og grafik) flyttes over én ad gangen. Indtil da kan du stadig bruge den gamle app."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Kommer snart -->
      <StackPanel x:Name="PageSoon" Visibility="Collapsed">
        <TextBlock x:Name="SoonTitle" Style="{StaticResource H1}"/>
        <Border Style="{StaticResource CardB}" Margin="0,20,0,0">
          <TextBlock x:Name="SoonText" Style="{StaticResource Sub}" FontSize="14"/>
        </Border>
      </StackPanel>

      <!-- Om -->
      <StackPanel x:Name="PageAbout" Visibility="Collapsed">
        <TextBlock Text="Om Opticon" Style="{StaticResource H1}"/>
        <Border Style="{StaticResource CardB}" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock x:Name="AboutVersion" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" Text="Opticon er gratis og open source. Koden ligger åbent på GitHub, så alle kan se præcis, hvad programmet gør."/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" x:Name="AboutData"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Åbn logmappen" Click="OpenLog_Click"/>
              <Button Content="Se koden på GitHub" Click="OpenGitHub_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
