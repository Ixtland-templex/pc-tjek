<UserControl x:Class="Opticon.Pages.SecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnAdmin" Content="🛡  Tjek som administrator" Click="Admin_Click" Visibility="Collapsed"/>
          <Button x:Name="BtnRefresh" Content="↻  Tjek igen" Style="{StaticResource Primary}" Click="Refresh_Click" Margin="0"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Sikkerhed" Style="{StaticResource H1}"/>
          <TextBlock Text="Er Windows' egen beskyttelse slået til? Opticon kan rette det meste med ét klik." Style="{StaticResource Sub}" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
      <!-- Scan pc'en -->
      <Border Style="{StaticResource CardB}" Margin="0,18,0,0">
        <StackPanel>
          <DockPanel Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnQuick" Content="Defender-hurtigscanning" Click="Quick_Click"/>
              <Button x:Name="BtnScan" Content="🔍  Scan pc'en" Style="{StaticResource Primary}" Click="Scan_Click" Margin="0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="🔍  Scan for malware" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="ScanSum" Style="{StaticResource Sub}" Margin="0,2,0,0" Text="Leder efter tegn på malware: Defenders fund, autostart, planlagte opgaver, tjenester, skjulte scripts, hosts-fil og proxy. Ændrer intet."/>
            </StackPanel>
          </DockPanel>
          <ProgressBar x:Name="ScanBar" Height="6" Maximum="100" Background="#1E2433" BorderThickness="0" Foreground="#8B5CF6" Visibility="Collapsed" Margin="0,6,0,6"/>
          <CheckBox x:Name="ChkAll" Content="Vis også det, der ser i orden ud" Visibility="Collapsed" Checked="ChkAll_Changed" Unchecked="ChkAll_Changed" Margin="0,6,0,6"/>
          <ItemsControl x:Name="ScanList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#1F2533" BorderThickness="0,1,0,0" Padding="0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Dot}" FontSize="15"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock FontSize="14" TextWrapping="Wrap"><Run Text="{Binding Risk, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  " Foreground="#6B7488"/><Run Text="{Binding Category, Mode=OneWay}" Foreground="#9AA3B5"/><Run Text="  ·  " Foreground="#6B7488"/><Run Text="{Binding Title, Mode=OneWay}"/></TextBlock>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Why}" Foreground="#C3CAD6" TextWrapping="Wrap" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding Path}" Style="{StaticResource Sub}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                      <TextBlock Text="{Binding Advice}" Visibility="{Binding AdviceVis}" Foreground="#F5B83D" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                      <Button Content="Vis fil" Tag="{Binding}" Click="ShowFile_Click" Visibility="{Binding PathVis}"/>
                      <Button Content="VirusTotal" Tag="{Binding}" Click="VirusTotal_Click" Visibility="{Binding PathVis}" Margin="0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardB}" Margin="0,14,0,14">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="SumBig" Text="…" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="SumTitle" Text="Tjekker…" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="SumSub" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <ItemsControl x:Name="List">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardB}" Margin="0,0,0,10" Padding="16,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Dot}" FontSize="16" VerticalAlignment="Top" Margin="0,1,0,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock FontSize="14"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  " Foreground="#6B7488"/><Run Text="{Binding Value, Mode=OneWay}"/></TextBlock>
                  <TextBlock Text="{Binding Note}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding How}" Visibility="{Binding HowVis}" Foreground="#C3CAD6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Button Content="Ret det" Style="{StaticResource Primary}" Tag="{Binding}" Click="Fix_Click" Visibility="{Binding FixVis}"/>
                  <Button Content="Åbn" Tag="{Binding}" Click="Open_Click" Visibility="{Binding UriVis}" Margin="0"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
