<UserControl x:Class="Opticon.Pages.GamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource CardB}">
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Padding" Value="16,12"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Spil og grafik" Style="{StaticResource H1}"/>
      <TextBlock Text="Tjek Windows' spilindstillinger, og mål hvor hurtig pc'en er." Style="{StaticResource Sub}" Margin="0,4,0,18"/>

      <!-- Benchmark -->
      <Border Style="{StaticResource CardB}" Margin="0,0,0,14">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnGpuOnly" Content="Kun grafik" Click="GpuOnly_Click"/>
              <Button x:Name="BtnBench" Content="▶  Kør benchmark" Style="{StaticResource Primary}" Click="Bench_Click" Margin="0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="⚡  Benchmark" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="BenchSub" Style="{StaticResource Sub}" Margin="0,2,0,0" Text="Tester processor, RAM, disk og grafikkort. Tager ca. 2½ minut. Luk spil og tunge programmer først."/>
            </StackPanel>
          </DockPanel>
          <ProgressBar x:Name="BenchBar" Height="6" Maximum="100" Background="#1E2433" BorderThickness="0" Foreground="#8B5CF6" Visibility="Collapsed" Margin="0,0,0,12"/>
          <WrapPanel x:Name="Tiles" Visibility="Collapsed">
            <Border Style="{StaticResource Tile}" Width="200"><StackPanel><TextBlock Text="Samlet" Style="{StaticResource Sub}"/><TextBlock x:Name="TScore" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="TScoreSub" Style="{StaticResource Sub}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Tile}" Width="200"><StackPanel><TextBlock Text="Processor" Style="{StaticResource Sub}"/><TextBlock x:Name="TCpu" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TCpuSub" Style="{StaticResource Sub}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Tile}" Width="200"><StackPanel><TextBlock Text="RAM" Style="{StaticResource Sub}"/><TextBlock x:Name="TRam" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="kopiering af store blokke" Style="{StaticResource Sub}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Tile}" Width="200"><StackPanel><TextBlock Text="Disk (C:)" Style="{StaticResource Sub}"/><TextBlock x:Name="TDisk" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TDiskSub" Style="{StaticResource Sub}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Tile}" Width="410"><StackPanel><TextBlock Text="Grafikkort (FPS uden skærmlås)" Style="{StaticResource Sub}"/><TextBlock x:Name="TGpu" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="TGpuSub" Style="{StaticResource Sub}" FontSize="12"/></StackPanel></Border>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Spilindstillinger -->
      <Border Style="{StaticResource CardB}">
        <StackPanel>
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="↻  Tjek igen" Click="Refresh_Click" Margin="0" VerticalAlignment="Center"/>
            <TextBlock Text="🎮  Windows' spilindstillinger" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <ItemsControl x:Name="SetList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#1F2533" BorderThickness="0,1,0,0" Padding="0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Dot}" FontSize="16"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock FontSize="14"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  " Foreground="#6B7488"/><Run Text="{Binding Value, Mode=OneWay}"/></TextBlock>
                      <TextBlock Text="{Binding Note}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding How}" Visibility="{Binding HowVis}" Foreground="#C3CAD6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                      <Button Content="Ret det" Style="{StaticResource Primary}" Tag="{Binding}" Click="Fix_Click" Visibility="{Binding FixVis}"/>
                      <Button Content="Åbn" Tag="{Binding}" Click="Open_Click" Visibility="{Binding UriVis}" Margin="0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardB}" Margin="0,14,0,0" Background="#1B1630" BorderBrush="#3B3366">
        <TextBlock Style="{StaticResource Sub}" Text="Strømtesten, &quot;Mål i mit spil&quot; og &quot;Hjalp det i mit spil?&quot; flyttes over i næste version. Indtil da findes de i den gamle app."/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
