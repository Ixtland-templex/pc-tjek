<UserControl x:Class="Opticon.Pages.GamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource CardB}">
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Padding" Value="16,12"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Spil og grafik" Style="{StaticResource H1}"/>
      <TextBlock Text="Tjek Windows' spilindstillinger, og mål hvor hurtig pc'en er." Style="{StaticResource Sub}" Margin="0,4,0,18"/>

      <!-- Benchmark -->
      <Border Style="{StaticResource CardB}" Margin="0,0,0,14">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnGpuOnly" Content="Kun grafik" Click="GpuOnly_Click"/>
              <Button x:Name="BtnBench" Content="▶  Kør benchmark" Style="{StaticResource Primary}" Click="Bench_Click" Margin="0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="⚡  Benchmark" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="BenchSub" Style="{StaticResource Sub}" Margin="0,2,0,0" Text="Tester processor, RAM, disk og grafikkort. Tager ca. 2½ minut. Luk spil og tunge programmer først."/>
            </StackPanel>
          </DockPanel>
          <ProgressBar x:Name="BenchBar" Height="6" Maximum="100" Background="#1E2433" BorderThickness="0" Foreground="#8B5CF6" Visibility="Collapsed" Margin="0,0,0,12"/>
          <WrapPanel x:Name="Tiles" Visibility="Collapsed">
            <Border Style="{StaticResource Tile}" Width="200"><StackPanel><TextBlock Text="Samlet" Style="{StaticResource Sub}"/><TextBlock x:Name="TScore" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="TScoreSub" Style="{StaticResource Sub}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Tile}" Width="200"><StackPanel><TextBlock Text="Processor" Style="{StaticResource Sub}"/><TextBlock x:Name="TCpu" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TCpuSub" Style="{StaticResource Sub}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Tile}" Width="200"><StackPanel><TextBlock Text="RAM" Style="{StaticResource Sub}"/><TextBlock x:Name="TRam" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="kopiering af store blokke" Style="{StaticResource Sub}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Tile}" Width="200"><StackPanel><TextBlock Text="Disk (C:)" Style="{StaticResource Sub}"/><TextBlock x:Name="TDisk" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TDiskSub" Style="{StaticResource Sub}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Tile}" Width="410"><StackPanel><TextBlock Text="Grafikkort (FPS uden skærmlås)" Style="{StaticResource Sub}"/><TextBlock x:Name="TGpu" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="TGpuSub" Style="{StaticResource Sub}" FontSize="12"/></StackPanel></Border>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Spilindstillinger -->
      <Border Style="{StaticResource CardB}">
        <StackPanel>
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="↻  Tjek igen" Click="Refresh_Click" Margin="0" VerticalAlignment="Center"/>
            <TextBlock Text="🎮  Windows' spilindstillinger" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <ItemsControl x:Name="SetList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#1F2533" BorderThickness="0,1,0,0" Padding="0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Dot}" FontSize="16"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock FontSize="14"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  " Foreground="#6B7488"/><Run Text="{Binding Value, Mode=OneWay}"/></TextBlock>
                      <TextBlock Text="{Binding Note}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding How}" Visibility="{Binding HowVis}" Foreground="#C3CAD6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                      <Button Content="Ret det" Style="{StaticResource Primary}" Tag="{Binding}" Click="Fix_Click" Visibility="{Binding FixVis}"/>
                      <Button Content="Åbn" Tag="{Binding}" Click="Open_Click" Visibility="{Binding UriVis}" Margin="0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Strømtest -->
      <Border Style="{StaticResource CardB}" Margin="0,14,0,0">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Button x:Name="BtnPower" DockPanel.Dock="Right" Content="🔋  Kør strømtest" Click="Power_Click" Margin="0" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Text="🔋  Strømtest" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="PowerSub" Style="{StaticResource Sub}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Kører grafiktesten i hver af Windows' strømtilstande og viser, hvor meget hurtigere den bliver, og hvad det koster i strøm. Tager ca. 1 minut. På en bærbar: tag opladeren ud for at måle batteriforbruget."/>
            </StackPanel>
          </DockPanel>
          <ItemsControl x:Name="PowerList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#1F2533" BorderThickness="0,1,0,0" Padding="0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Item1}" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="{Binding Item2}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding Item3}" HorizontalAlignment="Right" Foreground="#9AA3B5"/>
                    <TextBlock Grid.Column="3" Text="{Binding Item4}" HorizontalAlignment="Right" Foreground="#9AA3B5"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Mål i mit spil -->
      <Border Style="{StaticResource CardB}" Margin="0,14,0,0">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
<Button x:Name="GameDur" Content="⏱  60 sek." Click="Dur_Click" ToolTip="Hvor længe der måles"/>
              <Button x:Name="BtnAb" Content="Hjalp det?" Click="Ab_Click"/>
              <Button x:Name="BtnGame" Content="🎯  Mål i mit spil" Style="{StaticResource Primary}" Click="Game_Click" Margin="0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="🎯  Mål i mit spil" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="GameSub" Style="{StaticResource Sub}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Start dit spil, tryk på knappen, og spil videre. Opticon måler FPS, 1 % low og hak med Intels PresentMon og fortæller, hvad der bremser."/>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="GameText" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
        </StackPanel>
      </Border>

      <!-- NVIDIA strømgrænse -->
      <Border x:Name="NvCard" Style="{StaticResource CardB}" Margin="0,14,0,0" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="⚡  Grafikkortets strømgrænse (NVIDIA)" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="NvSub" Style="{StaticResource Sub}" Margin="0,2,0,10" TextWrapping="Wrap"/>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Standard" Click="NvReset_Click"/>
              <Button Content="Anvend" Style="{StaticResource Primary}" Click="NvApply_Click" Margin="0"/>
            </StackPanel>
            <TextBlock x:Name="NvVal" DockPanel.Dock="Right" Width="80" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="12,0"/>
            <Slider x:Name="NvSlider" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="NvSlider_Changed"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
