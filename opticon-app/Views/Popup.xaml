<Window x:Class="Opticon.Views.Popup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opticon Vagt" Width="400" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" AllowsTransparency="True" Background="Transparent">
  <Border Background="#141821" BorderBrush="#3B3366" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="8">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
    <StackPanel>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" Padding="8,2" Margin="0" Background="Transparent" BorderThickness="0" Foreground="#9AA3B5"/>
        <TextBlock x:Name="TitleText" Foreground="#E7E9EE" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
      </DockPanel>
      <TextBlock x:Name="BodyText" Foreground="#9AA3B5" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,10"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="Åbn Opticon" Style="{StaticResource Primary}" Click="Open_Click"/>
        <Button x:Name="BtnShow" Content="Vis fil" Click="Show_Click" Visibility="Collapsed"/>
        <Button Content="OK" Click="Close_Click" Margin="0"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
